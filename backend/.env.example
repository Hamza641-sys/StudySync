# AI Study Assistant Pro - Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# OpenAI API Key (Optional: system includes intelligent RAG fallback if not provided)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=studysync-pro-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@studysync-pro-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_private_key_with_escaped_newlines"

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=30
MAX_UPLOAD_SIZE_MB=15
